# =============================================================
# ReproAgent 服务器端 .env.prod —— 本文件只是「形状说明」，不要照着它手工填。
#
# 真身在服务器上由脚本生成：
#   cd /opt/reproagent/deploy/server && ./gen_secrets.sh <静态站 origin> <api 域名> <sb 域名>
# 它会以上游 supabase/docker 的 .env.example 为底本（那里有一百多个 compose 插值，
# 手工列必然漏，漏一个就是空串），盖上我们自己生成的机密，再追加应用侧的键。
#
# 为什么机密必须现场生成：`supabase start` 的 JWT_SECRET / anon key / service key 是
# 文档里公开的固定值。11-23 实测拿它自签一个 role=service_role 的 JWT，
# /auth/v1/admin/users 与 /rest/v1/papers 都回 200 —— 任何人都能绕开 RLS 读全库。
# =============================================================

# ---- gen_secrets.sh 生成、且和域名绑死的（换域名要重新生成）----
# JWT_SECRET                # 本机随机 64 hex；GoTrue/PostgREST/Storage 共用
# ANON_KEY / SERVICE_ROLE_KEY # 用上面的 JWT_SECRET 自签，iss 必须逐字等于 API_EXTERNAL_URL
# POSTGRES_PASSWORD / SECRET_KEY_BASE / VAULT_ENC_KEY / DASHBOARD_PASSWORD
# SITE_URL                  # 静态站 origin，GoTrue 登录后的回跳根
# API_EXTERNAL_URL          # https://api.<域名>；同时是 JWT 的 iss
# SUPABASE_PUBLIC_URL       # https://sb.<域名>；只放行 auth 四个路径，见 nginx-edge.conf
# CORS_ORIGINS              # 静态站 origin
# DISABLE_SIGNUP=true       # 服务端也关掉注册：账号由 create_demo_user.sh 预建
# SMTP_HOST=127.0.0.1       # 没有 SMTP；前端的忘记密码同步隐藏，两层各自独立

# ---- 上线前要人工填的两行 ----
QWEN_API_KEY=REPLACE_ME
# Zero Trust → Networks → Tunnels → cloudflared 建隧道，Public Hostname 两条：
#   api.<域名> -> http://api:8000
#   sb.<域名>  -> http://edge:80
# 存成 CLOUDFLARE_TUNNEL_TOKEN；edge 是路径白名单容器，不要直接填 kong。
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# ---- 演示账号凭据（前端「一键进入演示账号」按钮会内嵌进静态产物）----
DEMO_EMAIL=demo@reproagent.dev
DEMO_PASSWORD=<gen_secrets.sh 随机生成>

# ---- 并发闸门（4GB 机器的保命参数，gen_secrets.sh 已按此值写好）----
# 一次训练 = 一个 exec 沙箱（默认 512MB、上限 4GB），所以两处并发都必须是 1：
# arq 的 max_jobs 默认是 10，Runner 的默认是 4。
WORKER_MAX_JOBS=1
RUNNER_MAX_CONCURRENT_RUNS=1
RUNNER_TIMEOUT_SECONDS=600

# ---- Runner 沙箱 ----
RUNNER_HOST_WORK_DIR=/var/lib/reproagent/runner-work
EXEC_IMAGE=reproagent-exec:latest
# docker 报 "overlay2: missing pquota" 时改 false（代价：沙箱不限磁盘配额）。
RUNNER_ENFORCE_DISK_QUOTA=true

# ---- LLM 只进 agent 容器；SiliconFlow 的 Qwen 必须用 128K 那款 ----
# 32K 版跑完整 LeNet-5 论文（约 63K token）会 400，不要截断也不要分块。
QWEN_BASE_URL=https://api.siliconflow.cn/v1
QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct-128K

# ---- 大陆机房的镜像源（scripts/probe_server.sh 判 FAIL 的那几项才需要改）----
# REGISTRY_PREFIX=docker.m.daocloud.io/library/   # 影响 redis / cloudflared / nginx
# PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:latest

# ---- 数据落在哪 ----
# db 与 storage 的实际目录在 /var/lib/reproagent/supabase/{db-data,storage}；
# 上游 compose 里的 ./volumes/db/data、./volumes/storage 由 bootstrap.sh data
# 做成指向它们的软链接，所以删掉 /opt/supabase-src 这个 clone 不会带走数据。
