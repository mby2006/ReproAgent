# =============================================================
# ReproAgent environment template
# Copy to .env and fill in real values. Never commit .env.
# Local Supabase: run `supabase start` (from infra/) and copy the
# printed API URL / anon key / service_role key below.
# =============================================================

ENVIRONMENT=development

# ---- Supabase (shared by API only; agent/runner must NOT get these) ----
SUPABASE_URL=http://127.0.0.1:54321
# Browser-reachable URL used to build signed PDF links returned to the frontend.
# Defaults to SUPABASE_URL; set separately when the API reaches Supabase via an
# internal host (e.g. host.docker.internal) that the browser cannot resolve.
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Used by the containerized worker's LangGraph Postgres checkpointer. Inside the
# container the host DB is reached via host.docker.internal, not 127.0.0.1.
# Override only if your local Supabase DB uses a different password/port.
# SUPABASE_DB_URL_CONTAINER=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# ---- API service (apps/api, port 8000) ----
API_PORT=8000
AGENT_BASE_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000
# Redis backs the arq job queue (api + worker)
REDIS_URL=redis://127.0.0.1:6379

# ---- Agent service (apps/agent, port 8001) ----
AGENT_PORT=8001
RUNNER_BASE_URL=http://127.0.0.1:8002
# Qwen via an OpenAI-compatible endpoint.
# DashScope:  QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  QWEN_MODEL=qwen-plus
# SiliconFlow: QWEN_BASE_URL=https://api.siliconflow.cn/v1  QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct-128K
QWEN_API_KEY=sk-replace-with-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- Runner service (apps/runner, port 8002) ----
# NOTE: Runner receives NO LLM key and NO Supabase key, by design.
RUNNER_PORT=8002
RUNNER_WORK_DIR=./.runner-work
RUNNER_TIMEOUT_SECONDS=300

# ---- Web (apps/web, port 3000) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Optional build-time registry mirrors for restricted networks
# PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# uv 现在由 PyPI 装（infra/docker/*.Dockerfile），不再有 ghcr 镜像依赖
